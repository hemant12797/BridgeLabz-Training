{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/user-swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/user-swagger"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      },
      "notes-route": {
        "ClusterId": "notes-cluster",
        "Match": {
          "Path": "/api/Notes/{**catch-all}"
        }
      },
      "notes-swagger-route": {
        "ClusterId": "notes-cluster",
        "Match": {
          "Path": "/notes-swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notes-swagger"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      },
      "label-route": {
        "ClusterId": "label-cluster",
        "Match": {
          "Path": "/api/Label/{**catch-all}"
        }
      },
      "reminder-route": {
        "ClusterId": "label-cluster",
        "Match": {
          "Path": "/api/Reminder/{**catch-all}"
        }
      },
      "label-swagger-route": {
        "ClusterId": "label-cluster",
        "Match": {
          "Path": "/label-swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/label-swagger"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "notes-cluster": {
        "Destinations": {
          "notes-destination": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "label-cluster": {
        "Destinations": {
          "label-destination": {
            "Address": "http://localhost:5005/"
          }
        }
      }
    }
  }
}
